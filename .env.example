# Supabase project URL + publishable (anon) key. The publishable key is safe in the browser;
# all access is enforced by RLS + the add_house/remove_house functions.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional default map center "lat,lng" (used before GPS / when there are no houses yet)
VITE_MAP_CENTER=
